<Window x:Class="Vchange.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vchange" Width="740" Height="660" Icon="/Resources/app_white.ico"
        Background="Transparent" Foreground="{DynamicResource Theme.TextPrimary}" AllowsTransparency="False" ResizeMode="NoResize" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- 滑杆（蓝色已填充轨道 + 圆形拇指） -->
        <Style TargetType="{x:Type Slider}">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center" Background="Transparent">
                            <Border Height="6" CornerRadius="3" Background="{DynamicResource Theme.ProgressTrack}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent" Height="24">
                                                    <Border Height="6" CornerRadius="3" Background="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent" Height="24"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="20" Height="20" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Ellipse x:Name="thumbDot" Fill="White" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.5">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect Color="#FF0A84FF" BlurRadius="8" ShadowDepth="0" Opacity="0.35"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="thumbDot" Property="Fill" Value="#E6F2FF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="thumbDot" Property="StrokeThickness" Value="3.5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 醒目的选择圆点（大号，选中时蓝色圆环+实心点带弹出动画） -->
        <Style x:Key="BigDotRadioStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="outer" Width="22" Height="22" StrokeThickness="2"
                                     Stroke="{DynamicResource Theme.ToggleBorder}" Fill="{DynamicResource Theme.Control}"/>
                            <Ellipse x:Name="ringSelected" Width="22" Height="22" StrokeThickness="2"
                                     Stroke="{StaticResource AccentBrush}" Opacity="0"/>
                            <Ellipse x:Name="inner" Width="10" Height="10"
                                     Fill="{StaticResource AccentBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="innerScale" ScaleX="0" ScaleY="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ringSelected" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="innerScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="2"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="innerScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="2"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ringSelected" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="innerScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="innerScale" Storyboard.TargetProperty="ScaleY" To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="outer" Property="Stroke" Value="{DynamicResource Theme.ToggleBorderHover}"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主页功能卡片 -->
        <Style x:Key="HomeCardStyle" TargetType="{x:Type Button}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bd" Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.SurfaceBorder}" BorderThickness="1" CornerRadius="12" Padding="18">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.ItemSelected}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource Theme.WindowTint}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource Theme.TitleBar}" MouseLeftButtonDown="TitleBar_MouseDown">
                <DockPanel LastChildFill="False">
                    <Image x:Name="TitleBarIcon" Source="/Resources/app_white.ico" Width="16" Height="16" Margin="12,0,0,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Vchange" Foreground="{DynamicResource Theme.TextPrimary}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="14" FontWeight="SemiBold"/>
                    <Button DockPanel.Dock="Right" Content="✕" Width="46" Height="34" Background="Transparent" Foreground="{DynamicResource Theme.IconForeground}" BorderBrush="{x:Null}" FontSize="12" Click="Close_Click"/>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Padding="16,12,16,6" x:Name="StepIndicatorBorder">
                <StackPanel x:Name="StepIndicatorPanel" Orientation="Horizontal" HorizontalAlignment="Center"/>
            </Border>

            <Grid x:Name="HomePanel" Grid.Row="2" Margin="28,8,28,16">
                <StackPanel VerticalAlignment="Center" MaxWidth="660">
                    <TextBlock Text="选择功能" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Theme.TextPrimary}" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Text="请选择需要使用的工具" FontSize="13" Foreground="{DynamicResource Theme.TextSecondary}" Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>

                    <Button x:Name="HomeConvertCard" Style="{StaticResource HomeCardStyle}" Margin="0,26,0,0" Click="HomeConvert_Click">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="48" Height="48" CornerRadius="12" Background="#200A84FF" VerticalAlignment="Center">
                                <TextBlock Text="🎬" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="视频转换" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="将视频文件转换为其他格式（mp4 / mkv / mov …），可选编码、分辨率、帧率与码率" Foreground="{DynamicResource Theme.TextSecondary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="500"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button x:Name="HomeTimelapseCard" Style="{StaticResource HomeCardStyle}" Margin="0,14,0,0" Click="HomeTimelapse_Click">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="48" Height="48" CornerRadius="12" Background="#200A84FF" VerticalAlignment="Center">
                                <TextBlock Text="⏱" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="延时合成" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="将延时摄影拍摄的图片序列按顺序重命名并合成视频（每张图片为一帧），可选帧率、格式、编码与码率" Foreground="{DynamicResource Theme.TextSecondary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="500"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button x:Name="HomeStackCard" Style="{StaticResource HomeCardStyle}" Margin="0,14,0,0" Click="HomeStack_Click">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="48" Height="48" CornerRadius="12" Background="#200A84FF" VerticalAlignment="Center">
                                <TextBlock Text="🌌" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="图片堆砌" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="星轨、流水、车流等长曝光堆砌，支持最大值/平均/最小值合成，输出 JPG / PNG / BMP / TIFF / DNG" Foreground="{DynamicResource Theme.TextSecondary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="500"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button x:Name="HomeImageCard" Style="{StaticResource HomeCardStyle}" Margin="0,14,0,0" Click="HomeImageCard_Click">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="48" Height="48" CornerRadius="12" Background="#200A84FF" VerticalAlignment="Center">
                                <TextBlock Text="🖼️" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="图片转换" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="单张图片格式互转（JPG / PNG / BMP / TIFF / WebP / WMP / DNG），可调品质、压缩、色彩空间与分辨率" Foreground="{DynamicResource Theme.TextSecondary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="500"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="Step1Panel" Grid.Row="2" Margin="28,4,28,8" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,4,8,4">
                    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="选择要转换的视频文件" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="支持 mp4、avi、mkv、mov、wmv、flv、webm 等常见格式，可多选文件批量转换" Style="{StaticResource SectionSubtitleStyle}"/>
                            <Border Style="{StaticResource CardBorderStyle}" MaxWidth="640" Margin="0,18,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Name="InputFileTextBox" IsReadOnly="True" Height="40" VerticalAlignment="Center" FontSize="13"/>
                                    <Button Grid.Column="1" Content="浏览文件" Style="{StaticResource PrimaryButtonStyle}" Width="110" Height="40" Margin="12,0,0,0" Click="BrowseInput_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,16">
                    <Button Style="{StaticResource CircleBackButtonStyle}" ToolTip="返回主页" Click="BackToHome_Click">
                        <Path Data="M 14 7 L 1 7 M 7 1 L 1 7 L 7 13" Stroke="{DynamicResource Theme.IconForeground}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Button>
                    <Button Style="{StaticResource CircleNextButtonStyle}" ToolTip="下一步" Click="Step1Next_Click" Margin="16,0,0,0">
                        <Path Data="M 0 7 L 13 7 M 7 1 L 13 7 L 7 13" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="Step2Panel" Grid.Row="2" Margin="28,4,28,8" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,4,8,4">
                    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="选择输出格式" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="转换完成后的文件将保存为该格式" Style="{StaticResource SectionSubtitleStyle}"/>
                            <Border Style="{StaticResource CardBorderStyle}" MaxWidth="640" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="输出格式" Style="{StaticResource CardTitleStyle}" HorizontalAlignment="Center"/>
                                    <ComboBox Name="FormatComboBox" Width="280" Height="34" Margin="0,12,0,0" SelectionChanged="FormatComboBox_SelectionChanged" HorizontalAlignment="Center">
                                        <ComboBoxItem Content="mp4" IsSelected="True"/>
                                        <ComboBoxItem Content="avi" />
                                        <ComboBoxItem Content="mkv" />
                                        <ComboBoxItem Content="mov" />
                                        <ComboBoxItem Content="wmv" />
                                        <ComboBoxItem Content="flv" />
                                        <ComboBoxItem Content="webm" />
                                        <ComboBoxItem Content="mpg" />
                                        <ComboBoxItem Content="ts" />
                                        <ComboBoxItem Content="m4v" />
                                        <ComboBoxItem Content="3gp" />
                                        <ComboBoxItem Content="vob" />
                                        <ComboBoxItem Content="ogv" />
                                        <ComboBoxItem Content="m2ts" />
                                        <ComboBoxItem Content="rm" />
                                        <ComboBoxItem Content="rmvb" />
                                        <ComboBoxItem Content="asf" />
                                        <ComboBoxItem Content="mxf" />
                                        <ComboBoxItem Content="hevc" />
                                        <ComboBoxItem Content="gif" />
                                        <ComboBoxItem Content="apng（动图）" />
                                    </ComboBox>
                                    <TextBlock x:Name="FormatHintText" Text="输出扩展名: .mp4" Foreground="{DynamicResource Theme.TextSecondary}" Margin="0,12,0,0" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,16">
                    <Button Style="{StaticResource CircleBackButtonStyle}" ToolTip="上一步" Click="Step2Back_Click">
                        <Path Data="M 14 7 L 1 7 M 7 1 L 1 7 L 7 13" Stroke="{DynamicResource Theme.IconForeground}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Button>
                    <Button Style="{StaticResource CircleNextButtonStyle}" ToolTip="下一步" Click="Step2Next_Click" Margin="16,0,0,0">
                        <Path Data="M 0 7 L 13 7 M 7 1 L 13 7 L 7 13" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="Step3Panel" Grid.Row="2" Margin="28,4,28,8" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,4,8,4">
                    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="设置视频参数" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="视频编码、分辨率和帧率可以分别选择与原视频相同" Style="{StaticResource SectionSubtitleStyle}"/>

                            <Grid MaxWidth="860" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,5,10">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="视频编码" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="与原视频相同" FontSize="12" Foreground="{DynamicResource Theme.TextSecondary}" VerticalAlignment="Center"/>
                                                <CheckBox x:Name="CodecSameCheckBox" Margin="8,0,0,0" VerticalAlignment="Center" Checked="SameOption_Changed" Unchecked="SameOption_Changed"/>
                                            </StackPanel>
                                        </Grid>
                                        <ComboBox Name="CodecComboBox" Height="34" Margin="0,10,0,0" HorizontalAlignment="Stretch">
                                            <ComboBoxItem IsEnabled="False" FontWeight="Bold" Content="H.264 / AVC" />
                                            <ComboBoxItem Content="libx264 (常用)" IsSelected="True" />
                                            <ComboBoxItem Content="h264_nvenc" />
                                            <ComboBoxItem Content="h264_qsv" />
                                            <ComboBoxItem Content="h264_vaapi" />
                                            <ComboBoxItem Content="h264_amf" />
                                            <ComboBoxItem Content="h264_videotoolbox" />
                                            <ComboBoxItem IsEnabled="False" FontWeight="Bold" Content="H.265 / HEVC" />
                                            <ComboBoxItem Content="libx265 (常用)" />
                                            <ComboBoxItem Content="hevc_nvenc" />
                                            <ComboBoxItem Content="hevc_qsv" />
                                            <ComboBoxItem Content="hevc_vaapi" />
                                            <ComboBoxItem Content="hevc_amf" />
                                            <ComboBoxItem Content="hevc_videotoolbox" />
                                            <ComboBoxItem IsEnabled="False" FontWeight="Bold" Content="VP8 / VP9" />
                                            <ComboBoxItem Content="libvpx" />
                                            <ComboBoxItem Content="libvpx-vp9 (常用)" />
                                            <ComboBoxItem IsEnabled="False" FontWeight="Bold" Content="AV1" />
                                            <ComboBoxItem Content="libaom-av1 (常用)" />
                                            <ComboBoxItem Content="libsvtav1" />
                                            <ComboBoxItem Content="librav1e" />
                                            <ComboBoxItem Content="av1_nvenc" />
                                            <ComboBoxItem Content="av1_qsv" />
                                            <ComboBoxItem Content="av1_vaapi" />
                                            <ComboBoxItem IsEnabled="False" FontWeight="Bold" Content="VVC (H.266)" />
                                            <ComboBoxItem Content="vvc (常用)" />
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorderStyle}" Grid.Column="1" Margin="5,0,0,10">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="分辨率" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="与原视频相同" FontSize="12" Foreground="{DynamicResource Theme.TextSecondary}" VerticalAlignment="Center"/>
                                                <CheckBox x:Name="ResolutionSameCheckBox" Margin="8,0,0,0" VerticalAlignment="Center" Checked="SameOption_Changed" Unchecked="SameOption_Changed"/>
                                            </StackPanel>
                                        </Grid>
                                        <ComboBox Name="ResolutionComboBox" Height="34" Margin="0,10,0,0" HorizontalAlignment="Stretch" SelectionChanged="ResolutionComboBox_SelectionChanged">
                                            <ComboBoxItem Content="1920x1080 (1080P)" IsSelected="True"/>
                                            <ComboBoxItem Content="1280x720 (720P)" />
                                            <ComboBoxItem Content="854x480 (480P)" />
                                            <ComboBoxItem Content="640x360 (360P)" />
                                            <ComboBoxItem Content="2560x1440 (2K)" />
                                            <ComboBoxItem Content="3840x2160 (4K)" />
                                            <ComboBoxItem Content="7680x4320 (8K)" />
                                            <ComboBoxItem Content="自定义" />
                                        </ComboBox>
                                        <StackPanel x:Name="CustomResolutionPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,10,0,0">
                                            <TextBox Name="CustomResolutionWidthTextBox" Width="80" Height="30" TextChanged="CustomResolution_TextChanged" VerticalContentAlignment="Center"/>
                                            <TextBlock Text="×" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource Theme.TextSecondary}"/>
                                            <TextBox Name="CustomResolutionHeightTextBox" Width="80" Height="30" TextChanged="CustomResolution_TextChanged" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorderStyle}" Grid.Row="1" Margin="0,0,5,0">
                                    <StackPanel>
                                        <TextBlock Text="色彩空间" Style="{StaticResource CardTitleStyle}"/>
                                        <ComboBox x:Name="ColorSpaceCombo" Height="34" Margin="0,10,0,0" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="与原视频相同" IsSelected="True"/>
                                            <ComboBoxItem IsEnabled="False" FontWeight="Bold" Content="── SDR ──" />
                                            <ComboBoxItem Content="BT.709（高清标准）" />
                                            <ComboBoxItem Content="BT.601（标清标准）" />
                                            <ComboBoxItem IsEnabled="False" FontWeight="Bold" Content="── HDR（Rec.2100）──" />
                                            <ComboBoxItem Content="BT.2020（广色域）" />
                                            <ComboBoxItem Content="HDR10（PQ，10-bit）" />
                                            <ComboBoxItem Content="HLG（10-bit）" />
                                        </ComboBox>
                                        <TextBlock Text="写入对应色彩空间标记，解决画面发灰或过饱和问题；HDR 自动使用 Rec.2100 10-bit" Foreground="{DynamicResource Theme.TextSecondary}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorderStyle}" Grid.Row="1" Grid.Column="1" Margin="5,0,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="帧率" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="与原视频相同" FontSize="12" Foreground="{DynamicResource Theme.TextSecondary}" VerticalAlignment="Center"/>
                                                <CheckBox x:Name="FpsSameCheckBox" Margin="8,0,0,0" VerticalAlignment="Center" Checked="SameOption_Changed" Unchecked="SameOption_Changed"/>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <TextBox Name="FpsTextBox" Width="120" Height="34" Text="30" VerticalContentAlignment="Center"/>
                                            <TextBlock Text="fps（每秒帧数）" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Theme.TextSecondary}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
