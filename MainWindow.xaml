                                        <StackPanel x:Name="CCustomResolutionPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="10,0,0,0">
                                            <TextBox Name="CCustomResolutionWidthTextBox" Width="70" Height="34" VerticalContentAlignment="Center"/>
                                            <TextBlock Text="×" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource Theme.TextSecondary}"/>
                                            <TextBox Name="CCustomResolutionHeightTextBox" Width="70" Height="34" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock x:Name="CResInfoText" Text="" Foreground="{DynamicResource Theme.TextSecondary}" FontSize="12" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,16">
                    <Button Style="{StaticResource CircleBackButtonStyle}" ToolTip="上一步" Click="C3Back_Click">
                        <Path Data="M 14 7 L 1 7 M 7 1 L 1 7 L 7 13" Stroke="{DynamicResource Theme.IconForeground}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Button>
                    <Button Style="{StaticResource CircleNextButtonStyle}" ToolTip="下一步" Click="C3Next_Click" Margin="16,0,0,0">
                        <Path Data="M 0 7 L 13 7 M 7 1 L 13 7 L 7 13" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="C4Panel" Grid.Row="2" Margin="28,4,28,8" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,4,8,4">
                    <StackPanel>
                        <TextBlock Text="开始转换" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="确认下方设置后，点击开始转换" Style="{StaticResource SectionSubtitleStyle}"/>
                        <Border Style="{StaticResource CardBorderStyle}" MaxWidth="640" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="转换设置摘要" Style="{StaticResource CardTitleStyle}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="CSummaryTextBlock" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource Theme.TextPrimary}" FontSize="12" LineHeight="20"/>
                            </StackPanel>
                        </Border>
                        <Grid MaxWidth="640" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar x:Name="CProgressBar" IsIndeterminate="False" Visibility="Collapsed"/>
                            <TextBlock x:Name="CProgressTextBlock" Grid.Column="1" Text="" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextSecondary}" FontSize="12" Visibility="Collapsed"/>
                        </Grid>

                        <TextBlock Text="转换日志" Style="{StaticResource CardTitleStyle}" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                        <TextBox x:Name="CLogTextBox" Width="600" Height="100" Margin="0,6,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Center"/>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,16">
                    <Button Style="{StaticResource CircleBackButtonStyle}" ToolTip="上一步" Click="C4Back_Click">
                        <Path Data="M 14 7 L 1 7 M 7 1 L 1 7 L 7 13" Stroke="{DynamicResource Theme.IconForeground}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Button>
                    <Button x:Name="CStartButton" Content="开始转换" Style="{StaticResource PrimaryButtonStyle}" Width="150" Margin="16,0,0,0" Click="CStart_Click"/>
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</Window>
