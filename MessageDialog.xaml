<Window x:Class="Vchange.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示" Width="400" SizeToContent="Height"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        MouseLeftButtonDown="Window_MouseDown">
    <Border Margin="14" Background="{DynamicResource Theme.Dialog}" CornerRadius="12" BorderBrush="{DynamicResource Theme.SurfaceBorder}" BorderThickness="1"
            Effect="{StaticResource WindowDropShadow}">
        <StackPanel Margin="22,18,22,18">
            <TextBlock x:Name="TitleText" Text="提示" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}" HorizontalAlignment="Center"/>
            <TextBlock x:Name="MessageText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextSecondary}" FontSize="13" LineHeight="22" TextAlignment="Center"/>
            <StackPanel x:Name="SingleButtonPanel" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="知道了" Style="{StaticResource PrimaryButtonStyle}" Width="120" Click="Ok_Click"/>
            </StackPanel>
            <StackPanel x:Name="ConfirmButtonPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0" Visibility="Collapsed">
                <Button x:Name="ConfirmYesButton" Content="是" Style="{StaticResource PrimaryButtonStyle}" Width="110" Click="Yes_Click"/>
                <Button x:Name="ConfirmNoButton" Content="否" Style="{StaticResource SecondaryButtonStyle}" Width="110" Margin="14,0,0,0" Click="No_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
