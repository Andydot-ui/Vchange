<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Vchange</RootNamespace>
    <AssemblyName>Vchange</AssemblyName>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Resources\app_white.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- 排除嵌套的旧副本目录，避免重复编译 -->
  <ItemGroup>
    <Compile Remove="Vchange\**\*.cs" />
    <Page Remove="Vchange\**\*.xaml" />
    <Resource Remove="Vchange\**" />
    <Content Remove="Vchange\**" />
    <None Remove="Vchange\**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\app_white.ico" />
    <Resource Include="Resources\app_dark.ico" />
    <!-- 内嵌完整版 ffmpeg（仅 Release 发布时包含，首次运行释放到本地） -->
    <EmbeddedResource Include="Resources\ffmpeg.exe" Condition="'$(Configuration)' == 'Release'" />
  </ItemGroup>

</Project>
